{
  "manifest_version": 3,
  "name": "Focus Reminder",
  "version": "1.0",
  "description": "Reminds you of tasks before opening distracting sites.",
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://www.instagram.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}