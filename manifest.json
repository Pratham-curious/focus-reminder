{
  "manifest_version": 3,
  "name": "Focus Reminder",
  "version": "2.4",
  "description": "Reminds you of tasks before opening distracting sites.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.instagram.com/*"
      ],
      "css": ["styles.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}